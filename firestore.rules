rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // config/demo passcode must be readable without auth so the login page
    // can validate the funder passcode before any Firebase session exists.
    match /config/demo {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Public workshop registration — anyone can read workshop config and
    // submit a registration. Staff-only operations (delete, title/date edits)
    // still require sign-in via the catch-all rule below.
    match /workshops/{docId} {
      allow read: if true;
      // Public registrants need to increment the seat count inside a
      // transaction. Restrict public updates to the `locations` field only —
      // they cannot change title, active status, dates, or anything else.
      allow update: if request.resource.data.diff(resource.data)
                         .affectedKeys()
                         .hasOnly(['locations']);
    }
    match /workshopRegistrations/{docId} {
      allow create: if true;
    }

    // All authenticated users (signed-in @housingopps.org accounts) can read
    // and write any collection. The security boundary is Google login — only
    // staff with an org account can reach this app.
    match /{document=**} {
      allow read, write: if isSignedIn();
    }

  }
}
